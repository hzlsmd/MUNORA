{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "munora-recommendations",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "vars": {
    "GEMINI_MODEL": "",
    "ALLOWED_ORIGINS": "",
    "DAILY_AI_LIMIT": "100",
    "CLIENT_MINUTE_LIMIT": "5"
  },
  "durable_objects": {"bindings": [{"name": "BUDGET", "class_name": "RecommendationBudget"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["RecommendationBudget"]}],
  "observability": {"enabled": false}
}
